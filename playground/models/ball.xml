<mujoco model="ball">
  <!-- Default model for scripts/studio.ps1 and `docker compose up studio`.
       A capsule dropping onto a floor: simple enough to confirm the viewer,
       contact pipeline and rendering in one look. -->
  <option timestep="0.002"/>

  <worldbody>
    <light diffuse=".8 .8 .8" pos="1 -1 2" dir="-1 1 -2"/>
    <geom name="floor" type="plane" size="2 2 .1" rgba=".6 .6 .6 1"/>

    <body name="ball" pos="0 0 1">
      <freejoint/>
      <geom type="capsule" size=".1 .2" rgba=".8 .2 .2 1" mass="1"/>
    </body>
  </worldbody>
</mujoco>
